  <p><em>Ende des Impressums</em></p>

</div>

<!-- Nach-oben Button -->
<a href="#" class="back-to-top" title="Nach oben scrollen">↑</a>

<script>
/* ---------- Dropdown Menü Steuerung ---------- */
const menuBtn = document.getElementById("menuBtn");
const dropdownMenu = document.getElementById("dropdownMenu");

menuBtn.addEventListener("click", (e) => {
  e.stopPropagation();
  dropdownMenu.classList.toggle("show");
});

document.addEventListener("click", () => {
  dropdownMenu.classList.remove("show");
});

/* ---------- Sprach-Steuerung mit Umleitung ---------- */
let lang = localStorage.getItem("lang") || "de";

// Visuellen Status beim Laden setzen
document.getElementById("lang-en").classList.toggle("active", lang === "en");
document.getElementById("lang-de").classList.toggle("active", lang === "de");

function switchLanguage(targetLang) {
  localStorage.setItem("lang", targetLang);
  
  if (targetLang === "en") {
    // Wechselt zur englischen Rechtstext-Datei
    window.location.href = "../en/legalInformations_1.0.html";
  } else {
    // Wechselt zur deutschen Rechtstext-Datei
    window.location.href = "../de/legalInformations_1.0.html";
  }
}

document.getElementById("lang-en").onclick = () => switchLanguage("en");
document.getElementById("lang-de").onclick = () => switchLanguage("de");
</script>

</body>
